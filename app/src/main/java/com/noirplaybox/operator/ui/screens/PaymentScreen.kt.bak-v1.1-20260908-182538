private const val PAYMENT_STATUS_POLL_MS = 5_000L
private const val PAYMENT_NOTIFICATION_CHANNEL_ID = "payment_paid"
private const val PAYMENT_NOTIFICATION_ID = 2206

@Composable
fun PaymentScreen(
    packages: List<RentalPackage>,
    repository: PaymentRepository
) {
    var payment by remember { mutableStateOf<PaymentOrder?>(null) }
    var creating by remember { mutableStateOf(false) }
    var checking by remember { mutableStateOf(false) }
    var error by remember { mutableStateOf<String?>(null) }
    var qrBitmap by remember { mutableStateOf<Bitmap?>(null) }
    var qrLoading by remember { mutableStateOf(false) }
    var successNotified by remember { mutableStateOf(false) }
    val scope = rememberCoroutineScope()
    val haptic = LocalHapticFeedback.current
    val notificationContext = LocalContext.current

    fun createPayment(packageId: String) {
        if (creating) return
        scope.launch {
            creating = true
            error = null
            qrBitmap = null
            successNotified = false
            runCatching { repository.create(packageId) }
                .onSuccess { payment = it }
                .onFailure { error = friendlyError(it) }
            creating = false
        }
    }

    fun refreshStatus() {
        val current = payment ?: return
        if (checking || current.status != "PENDING") return
        scope.launch {
            checking = true
            runCatching { repository.status(current.orderId) }
                .onSuccess { payment = it }
                .onFailure { error = friendlyError(it) }
            checking = false
        }
    }

    val qrUrl = payment?.qrUrl
    LaunchedEffect(qrUrl) {
        qrBitmap = null
        if (qrUrl.isNullOrBlank()) return@LaunchedEffect
        qrLoading = true
        qrBitmap = runCatching {
            withContext(Dispatchers.IO) {
                URL(qrUrl).openStream().use { BitmapFactory.decodeStream(it) }
            }
        }.getOrNull()
        qrLoading = false
    }

    LaunchedEffect(payment?.orderId, payment?.status) {
        while (payment?.status == "PENDING") {
            delay(PAYMENT_STATUS_POLL_MS)
            val current = payment ?: break
            runCatching { repository.status(current.orderId) }
                .onSuccess { payment = it }
        }
    }

    LaunchedEffect(payment?.status) {
        if (payment?.status == "PAID" && !successNotified) {
            successNotified = true
            haptic.performHapticFeedback(HapticFeedbackType.LongPress)
            showPaymentPaidNotification(
                context = notificationContext,
                packageName = payment?.packageName.orEmpty(),
                amount = payment?.amount ?: 0,
                orderId = payment?.orderId.orEmpty()
            )
            runCatching {
                ToneGenerator(AudioManager.STREAM_NOTIFICATION, 85).apply {
                    startTone(ToneGenerator.TONE_PROP_ACK, 350)
                    release()
                }
            }
        }
    }

    Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
        when (payment?.status) {
            "PAID" -> PaidContent(
                payment = payment!!,
                onDone = {
                    payment = null
                    error = null
                    qrBitmap = null
                    successNotified = false
                }
            )
            "EXPIRED", "FAILED", "CANCELLED", "DENY" -> FailedContent(
                payment = payment!!,
                onNewPayment = {
                    payment = null
                    error = null
                    qrBitmap = null
                }
            )
            "PENDING" -> PendingContent(
                payment = payment!!,
                qrBitmap = qrBitmap,
                qrLoading = qrLoading,
                checking = checking,
                error = error,
                qrUrl = payment!!.qrUrl,
                onRefresh = ::refreshStatus,
                onCancel = {
                    payment = null
                    error = null
                    qrBitmap = null
                }
            )
            else -> PackagePicker(
                packages = packages,
                creating = creating,
                error = error,
                onPackageClick = ::createPayment
            )
        }
    }
}

@Composable
private fun PackagePicker(
    packages: List<RentalPackage>,
    creating: Boolean,
    error: String?,
    onPackageClick: (String) -> Unit
) {
    LazyColumn(
        modifier = Modifier.fillMaxSize().padding(horizontal = 20.dp),
        contentPadding = androidx.compose.foundation.layout.PaddingValues(top = 24.dp, bottom = 28.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        item {
            Text("Payment", style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
            Spacer(Modifier.height(4.dp))
            Text(
                "Pilih paket, tampilkan QRIS, lalu tunggu konfirmasi pembayaran.",
                style = MaterialTheme.typography.bodyMedium,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
            if (error != null) {
                Spacer(Modifier.height(12.dp))
                Text(error, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodyMedium)
            }
            Spacer(Modifier.height(8.dp))
        }
        items(packages, key = { it.id }) { item ->
            Card(
                modifier = Modifier.fillMaxWidth().clickable(enabled = !creating) { onPackageClick(item.id) },
                shape = RoundedCornerShape(20.dp),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
                elevation = CardDefaults.cardElevation(defaultElevation = 1.dp)
            ) {
                Row(
                    modifier = Modifier.fillMaxWidth().padding(18.dp),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Column {
                        Text(item.label, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
                        Text("${item.durationMinutes} menit", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
                    }
                    Text(rupiah(item.price), color = MaterialTheme.colorScheme.primary, fontWeight = FontWeight.Bold)
                }
            }
        }
        if (creating) {
            item {
                Row(Modifier.fillMaxWidth().padding(16.dp), horizontalArrangement = Arrangement.Center) {
                    CircularProgressIndicator(modifier = Modifier.size(24.dp), strokeWidth = 2.5.dp)
                }
            }
        }
    }
}

@Composable
private fun PendingContent(
    payment: PaymentOrder,
    qrBitmap: Bitmap?,
    qrLoading: Boolean,
    checking: Boolean,
    error: String?,
    qrUrl: String?,
    onRefresh: () -> Unit,
    onCancel: () -> Unit
) {
    val clipboard = LocalClipboardManager.current
    val context = LocalContext.current

    Column(
        modifier = Modifier.fillMaxSize().padding(20.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Spacer(Modifier.height(12.dp))
        Icon(Icons.Rounded.Payments, contentDescription = null, tint = MaterialTheme.colorScheme.primary, modifier = Modifier.size(36.dp))
        Spacer(Modifier.height(10.dp))
        Text("Menunggu Pembayaran", style = MaterialTheme.typography.headlineSmall, fontWeight = FontWeight.Bold)
        Text(payment.packageName, color = MaterialTheme.colorScheme.onSurfaceVariant)
        Spacer(Modifier.height(8.dp))
        Text(rupiah(payment.amount), style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
        Spacer(Modifier.height(20.dp))

        Card(
            shape = RoundedCornerShape(24.dp),
            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
        ) {
            Box(modifier = Modifier.size(280.dp).padding(18.dp), contentAlignment = Alignment.Center) {
                when {
                    qrBitmap != null -> Image(
                        bitmap = qrBitmap.asImageBitmap(),
                        contentDescription = "QRIS",
                        modifier = Modifier.fillMaxSize()
                    )
                    qrLoading -> CircularProgressIndicator()
                    else -> Text("QRIS belum tersedia", textAlign = TextAlign.Center)
                }
            }
        }

        Spacer(Modifier.height(12.dp))
        if (!qrUrl.isNullOrBlank()) {
            Text(
                "Sandbox testing",
                style = MaterialTheme.typography.labelMedium,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
            Spacer(Modifier.height(8.dp))
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                OutlinedButton(
                    onClick = { clipboard.setText(AnnotatedString(qrUrl)) },
                    modifier = Modifier.weight(1f)
                ) {
                    Icon(Icons.Rounded.ContentCopy, contentDescription = null, modifier = Modifier.size(18.dp))
                    Text("  Copy QR Link")
                }
                OutlinedButton(
                    onClick = {
                        runCatching {
                            context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(qrUrl)))
                        }
                    },
                    modifier = Modifier.weight(1f)
                ) {
                    Icon(Icons.Rounded.OpenInBrowser, contentDescription = null, modifier = Modifier.size(18.dp))
                    Text("  Open Link")
                }
            }
        }

        Spacer(Modifier.height(16.dp))
        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            if (checking) CircularProgressIndicator(modifier = Modifier.size(16.dp), strokeWidth = 2.dp)
            Text("Menunggu konfirmasi Midtrans…", style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
        if (error != null) {
            Spacer(Modifier.height(8.dp))
            Text(error, color = MaterialTheme.colorScheme.error, textAlign = TextAlign.Center)
        }
        Spacer(Modifier.height(18.dp))
        Button(onClick = onRefresh, enabled = !checking, modifier = Modifier.fillMaxWidth()) {
            Icon(Icons.Rounded.Refresh, contentDescription = null, modifier = Modifier.size(18.dp))
            Text("  Cek pembayaran")
        }
        Spacer(Modifier.height(8.dp))
        OutlinedButton(onClick = onCancel, modifier = Modifier.fillMaxWidth()) {
            Text("Batalkan tampilan QR")
        }
        Spacer(Modifier.height(10.dp))
        Text(
            "Jangan lanjutkan rental sebelum status berubah menjadi Pembayaran Berhasil.",
            style = MaterialTheme.typography.bodySmall,
            color = MaterialTheme.colorScheme.onSurfaceVariant,
            textAlign = TextAlign.Center
        )
    }
}

@Composable
private fun PaidContent(payment: PaymentOrder, onDone: () -> Unit) {
    Column(
        modifier = Modifier.fillMaxSize().padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Icon(Icons.Rounded.CheckCircle, contentDescription = null, tint = MaterialTheme.colorScheme.primary, modifier = Modifier.size(72.dp))
        Spacer(Modifier.height(16.dp))
        Text("Pembayaran Berhasil", style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
        Spacer(Modifier.height(6.dp))
        Text(payment.packageName, color = MaterialTheme.colorScheme.onSurfaceVariant)
        Spacer(Modifier.height(10.dp))
        Text(rupiah(payment.amount), style = MaterialTheme.typography.displaySmall, fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.primary)
        Spacer(Modifier.height(12.dp))
        HorizontalDivider()
        Spacer(Modifier.height(12.dp))
        Text("Pembayaran sudah dikonfirmasi oleh Midtrans.", textAlign = TextAlign.Center, color = MaterialTheme.colorScheme.onSurfaceVariant)
        Spacer(Modifier.height(24.dp))
        Button(onClick = onDone, modifier = Modifier.fillMaxWidth()) { Text("Selesai") }
    }
}

@Composable
private fun FailedContent(payment: PaymentOrder, onNewPayment: () -> Unit) {
    Column(
        modifier = Modifier.fillMaxSize().padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Text("Pembayaran ${payment.status.lowercase().replaceFirstChar { it.uppercase() }}", style = MaterialTheme.typography.headlineSmall, fontWeight = FontWeight.Bold)
        Spacer(Modifier.height(8.dp))
        Text("QRIS ini tidak dapat digunakan lagi. Buat pembayaran baru untuk melanjutkan.", textAlign = TextAlign.Center, color = MaterialTheme.colorScheme.onSurfaceVariant)
        Spacer(Modifier.height(24.dp))
        Button(onClick = onNewPayment, modifier = Modifier.fillMaxWidth()) { Text("Buat pembayaran baru") }
    }
}

private fun rupiah(value: Int): String =
    NumberFormat.getCurrencyInstance(Locale("id", "ID")).format(value.toLong()).replace(",00", "")


private fun showPaymentPaidNotification(
    context: Context,
    packageName: String,
    amount: Int,
    orderId: String
) {
    val manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
        val channel = NotificationChannel(
            PAYMENT_NOTIFICATION_CHANNEL_ID,
            "Pembayaran berhasil",
            NotificationManager.IMPORTANCE_HIGH
        ).apply {
            description = "Notifikasi ketika pembayaran Noir Playbox sudah PAID"
            enableVibration(true)
            // Bunyi konfirmasi tetap diberikan oleh ToneGenerator di PaymentScreen,
            // sehingga channel dibuat tanpa suara tambahan agar tidak bunyi dua kali.
            setSound(null, null)
        }
        manager.createNotificationChannel(channel)
    }

    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
        ContextCompat.checkSelfPermission(context, android.Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
    ) return

    val detail = buildString {
        append(if (packageName.isBlank()) "Pembayaran" else packageName)
        if (amount > 0) append(" • ${rupiah(amount)}")
    }
    val notification = NotificationCompat.Builder(context, PAYMENT_NOTIFICATION_CHANNEL_ID)
        .setSmallIcon(android.R.drawable.ic_dialog_info)
        .setContentTitle("Pembayaran Berhasil ✓")
        .setContentText(detail)
        .setStyle(NotificationCompat.BigTextStyle().bigText("$detail\nOrder: $orderId\nPembayaran telah dikonfirmasi Midtrans."))
        .setPriority(NotificationCompat.PRIORITY_HIGH)
        .setCategory(NotificationCompat.CATEGORY_STATUS)
        .setAutoCancel(true)
        .build()

    NotificationManagerCompat.from(context).notify(PAYMENT_NOTIFICATION_ID, notification)
}
