    onCancel: () -> Unit
) {
    val clipboard = LocalClipboardManager.current
    val context = LocalContext.current

    Column(
        modifier = Modifier.fillMaxSize().padding(20.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Spacer(Modifier.height(12.dp))
        Icon(Icons.Rounded.Payments, contentDescription = null, tint = MaterialTheme.colorScheme.primary, modifier = Modifier.size(36.dp))
        Spacer(Modifier.height(10.dp))
        Text("Menunggu Pembayaran", style = MaterialTheme.typography.headlineSmall, fontWeight = FontWeight.Bold)
        Text(payment.packageName, color = MaterialTheme.colorScheme.onSurfaceVariant)
        Spacer(Modifier.height(8.dp))
        Text(rupiah(payment.amount), style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
        Spacer(Modifier.height(10.dp))
        AssistChip(
            onClick = {},
            enabled = false,
            label = {
                Text(
                    when {
                        countdownSeconds == null -> "PENDING"
                        countdownSeconds <= 0 -> "QR kedaluwarsa"
                        else -> "PENDING • ${formatCountdown(countdownSeconds)}"
                    }
                )
            }
        )
        Spacer(Modifier.height(20.dp))

        Card(
            shape = RoundedCornerShape(24.dp),
            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
        ) {
            Box(modifier = Modifier.size(280.dp).padding(18.dp), contentAlignment = Alignment.Center) {
                when {
                    qrBitmap != null -> Image(
                        bitmap = qrBitmap.asImageBitmap(),
                        contentDescription = "QRIS",
                        modifier = Modifier.fillMaxSize()
                    )
                    qrLoading -> CircularProgressIndicator()
                    else -> Text("QRIS belum tersedia", textAlign = TextAlign.Center)
                }
            }
        }

        Spacer(Modifier.height(12.dp))
        if (!qrUrl.isNullOrBlank()) {
            Text(
                "Sandbox testing",
                style = MaterialTheme.typography.labelMedium,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
            Spacer(Modifier.height(8.dp))
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                OutlinedButton(
                    onClick = { clipboard.setText(AnnotatedString(qrUrl)) },
                    modifier = Modifier.weight(1f)
                ) {
                    Icon(Icons.Rounded.ContentCopy, contentDescription = null, modifier = Modifier.size(18.dp))
                    Text("  Copy QR Link")
                }
                OutlinedButton(
                    onClick = {
                        runCatching {
                            context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(qrUrl)))
                        }
                    },
                    modifier = Modifier.weight(1f)
                ) {
                    Icon(Icons.Rounded.OpenInBrowser, contentDescription = null, modifier = Modifier.size(18.dp))
                    Text("  Open Link")
                }
            }
        }

        Spacer(Modifier.height(16.dp))
        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            if (checking) CircularProgressIndicator(modifier = Modifier.size(16.dp), strokeWidth = 2.dp)
            Text("Menunggu konfirmasi Midtrans…", style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
        if (error != null) {
            Spacer(Modifier.height(8.dp))
            Text(
                "Status terakhir belum bisa diperbarui. $error",
                color = MaterialTheme.colorScheme.error,
                textAlign = TextAlign.Center
            )
        }
        Spacer(Modifier.height(18.dp))
        Button(onClick = onRefresh, enabled = !checking, modifier = Modifier.fillMaxWidth()) {
            Icon(Icons.Rounded.Refresh, contentDescription = null, modifier = Modifier.size(18.dp))
            Text("  Cek pembayaran")
        }
        Spacer(Modifier.height(8.dp))
        OutlinedButton(onClick = onCancel, modifier = Modifier.fillMaxWidth()) {
            Text("Batalkan tampilan QR")
        }
        Spacer(Modifier.height(10.dp))
        Text(
            "Order: ${payment.orderId}",
            style = MaterialTheme.typography.labelSmall,
            color = MaterialTheme.colorScheme.onSurfaceVariant,
            textAlign = TextAlign.Center
        )
        Spacer(Modifier.height(6.dp))
        Text(
            "Jangan lanjutkan rental sebelum status berubah menjadi Pembayaran Berhasil.",
            style = MaterialTheme.typography.bodySmall,
            color = MaterialTheme.colorScheme.onSurfaceVariant,
            textAlign = TextAlign.Center
        )
    }
}

