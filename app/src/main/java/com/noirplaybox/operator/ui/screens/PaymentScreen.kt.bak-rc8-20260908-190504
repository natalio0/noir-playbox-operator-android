private suspend fun playPaymentSuccessTone() {
    val tone = ToneGenerator(AudioManager.STREAM_NOTIFICATION, 90)
    try {
        tone.startTone(ToneGenerator.TONE_PROP_BEEP, 110)
        delay(150)
        tone.startTone(ToneGenerator.TONE_PROP_ACK, 230)
        delay(260)
    } finally {
        tone.release()
    }
}

private fun rupiah(value: Int): String =
    NumberFormat.getCurrencyInstance(Locale("id", "ID")).format(value.toLong()).replace(",00", "")



private fun formatCountdown(totalSeconds: Int): String {
    val safe = totalSeconds.coerceAtLeast(0)
    return "%02d:%02d".format(safe / 60, safe % 60)
}

private fun extractExpiryEpochMs(payment: PaymentOrder): Long? {
    return runCatching {
        val getter = payment.javaClass.methods.firstOrNull {
            it.name == "getExpiryTime" && it.parameterCount == 0
        } ?: return@runCatching null

        when (val raw = getter.invoke(payment)) {
            is Number -> {
                val value = raw.toLong()
                if (value in 1..9_999_999_999L) value * 1_000L else value
            }
            is String -> parseExpiryString(raw)
            else -> null
        }
    }.getOrNull()
}

private fun parseExpiryString(value: String): Long? {
    val trimmed = value.trim()
    if (trimmed.isBlank()) return null

    trimmed.toLongOrNull()?.let {
        return if (it in 1..9_999_999_999L) it * 1_000L else it
    }

    for (pattern in listOf("yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss.SSS")) {
        val parsed = runCatching {
            LocalDateTime.parse(trimmed, DateTimeFormatter.ofPattern(pattern))
                .atZone(ZoneId.systemDefault())
                .toInstant()
                .toEpochMilli()
        }.getOrNull()
        if (parsed != null) return parsed
    }
    return null
}

private fun showPaymentPaidNotification(
    context: Context,
    packageName: String,
    amount: Int,
    orderId: String
) {
    val manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
        val channel = NotificationChannel(
            PAYMENT_NOTIFICATION_CHANNEL_ID,
            "Pembayaran berhasil",
            NotificationManager.IMPORTANCE_HIGH
        ).apply {
            description = "Notifikasi ketika pembayaran Noir Playbox sudah PAID"
            enableVibration(true)
            // Bunyi konfirmasi tetap diberikan oleh ToneGenerator di PaymentScreen,
            // sehingga channel dibuat tanpa suara tambahan agar tidak bunyi dua kali.
            setSound(null, null)
        }
        manager.createNotificationChannel(channel)
    }

    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
        ContextCompat.checkSelfPermission(context, android.Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
    ) return

    val detail = buildString {
        append(if (packageName.isBlank()) "Pembayaran" else packageName)
        if (amount > 0) append(" • ${rupiah(amount)}")
    }
    val notification = NotificationCompat.Builder(context, PAYMENT_NOTIFICATION_CHANNEL_ID)
        .setSmallIcon(android.R.drawable.ic_dialog_info)
        .setContentTitle("Pembayaran Berhasil ✓")
        .setContentText(detail)
        .setStyle(NotificationCompat.BigTextStyle().bigText("$detail\nOrder: $orderId\nPembayaran telah dikonfirmasi Midtrans."))
        .setPriority(NotificationCompat.PRIORITY_HIGH)
        .setCategory(NotificationCompat.CATEGORY_STATUS)
        .setAutoCancel(true)
        .build()

    NotificationManagerCompat.from(context).notify(PAYMENT_NOTIFICATION_ID, notification)
}
